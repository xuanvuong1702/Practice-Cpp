# Makefile.config - Cấu hình chung cho toàn bộ project
# File này được include bởi các Makefile con

# Compiler
CC = gcc

# Compiler flags
CFLAGS = -Wall -Wextra -std=c11 -g

# Tối ưu hóa (comment out để disable)
# CFLAGS += -O2

# Cho Apple Silicon (M1/M2) - uncomment nếu cần
# CFLAGS += -arch arm64

# Sanitizers cho debugging (uncomment để enable)
# CFLAGS += -fsanitize=address
# LDFLAGS += -fsanitize=address

# Archive tool
AR = ar
ARFLAGS = rcs

# Build directories
BUILD_DIR = build
LIB_DIR = $(BUILD_DIR)/lib
BIN_DIR = $(BUILD_DIR)/bin
OBJ_DIR = $(BUILD_DIR)/obj
